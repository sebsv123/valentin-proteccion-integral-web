# URL del agente AI de seguros (Rosa)
# Ejemplo: https://tu-tunnel.trycloudflare.com
NEXT_PUBLIC_AGENT_URL=https://tu-tunnel.trycloudflare.com
# Optional browser integrations. Keep server-only keys out of this file.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Guardrail: localhost lead requests cannot use real SMTP by default.
ALLOW_LOCAL_LEAD_DELIVERY=false
